<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>0.85 -0.8 0.55 0 0.4 2.3</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.2 0.3 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="red_target">
      <static>true</static>
      <pose>0.30 0 0.020 0 0 0</pose>
      <link name="box">
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.95 0.02 0.02 1</ambient><diffuse>0.95 0.02 0.02 1</diffuse></material>
        </visual>
      </link>
    </model>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>
  </world>
</sdf>
